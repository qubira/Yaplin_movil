generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  supervisor
  cajero
}

enum StoreStatus {
  active
  inactive
}

enum SubscriptionStatus {
  trial
  active
  suspended
  expired
  cancelled
}

enum TransactionStatus {
  confirmed
  voided
}

enum TransactionSource {
  auto
  manual
}

enum TransactionEventType {
  CAPTURED // automatic notification landed in GENERAL (or directly in a store if the business has only one)
  MANUAL_CREATED // owner entered it by hand
  ASSIGNED // fromStoreId: string|null, toStoreId: string — covers GENERAL->Store and Store->Store
  RETURNED_TO_GENERAL // toStoreId goes back to null
  AMOUNT_CORRECTED // delta, reason, previousAmount, newAmount
  VOIDED // reason
  VOID_REVERSED // reason — reversing a void is a new event, VOIDED is never edited
  NOTE_ADDED // note
}

enum RiskLevel {
  normal
  watch
  suspicious
  blocked
}

enum IntentSeverity {
  low
  medium
  high
  critical
}

enum IntentEventType {
  LOGIN_FAILED
  BLOCKED_STORE_ACCESS
  BLOCKED_ROLE_ACTION
  WRONG_CONFIRMATION
  RISK_ESCALATED
  ACCOUNT_AUTO_BLOCKED
}

model Business {
  id               String   @id @default(cuid())
  name             String
  ruc              String?
  autoBlockEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())

  users           User[]
  stores          Store[]
  subscription    Subscription?
  transactions    Transaction[]
  intentAuditLogs IntentAuditLog[]
}

model User {
  id                 String    @id @default(cuid())
  businessId         String
  business           Business  @relation(fields: [businessId], references: [id])
  email              String    @unique
  passwordHash       String
  name               String
  initials           String
  role               Role
  storeId            String?
  active             Boolean   @default(true)
  riskLevel          RiskLevel @default(normal)
  transactionPinHash String?
  soundAlertEnabled  Boolean   @default(true)
  createdAt          DateTime  @default(now())
}

model Store {
  id         String      @id @default(cuid())
  businessId String
  business   Business    @relation(fields: [businessId], references: [id])
  name       String
  address    String?
  account    String?
  status     StoreStatus @default(active)
  methods    String[]
  createdAt  DateTime    @default(now())

  transactions Transaction[]
}

model Transaction {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id])
  storeId        String? // null = GENERAL (unassigned pool)
  store          Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  payerName      String
  payerInitials  String
  originalAmount Decimal           @db.Decimal(10, 2) // never changes after creation
  amount         Decimal           @db.Decimal(10, 2) // projection: originalAmount + sum of AMOUNT_CORRECTED deltas
  method         String
  timestamp      DateTime // capture time, never changes
  reference      String
  status         TransactionStatus @default(confirmed)
  read           Boolean           @default(false) // inbox state, not a financial fact — never becomes an event
  source         TransactionSource @default(auto)
  version        Int               @default(0) // optimistic lock
  createdAt      DateTime          @default(now())

  events TransactionEvent[]

  @@index([businessId, timestamp])
  @@index([businessId, storeId, timestamp])
  @@index([storeId, timestamp])
}

model TransactionEvent {
  seq           BigInt               @id @default(autoincrement()) // strict ordering, practically free on Postgres
  id            String               @unique @default(cuid())
  transactionId String
  transaction   Transaction          @relation(fields: [transactionId], references: [id])
  type          TransactionEventType
  payload       Json?
  actorId       String? // null = system event (automatic capture); no @relation, User is hard-deletable
  actorName     String // copied at the time of the event ("Sistema" if actorId is null)
  actorRole     String // copied at the time of the event
  createdAt     DateTime             @default(now())

  @@index([transactionId, seq])
}

model IntentAuditLog {
  id         String          @id @default(cuid())
  createdAt  DateTime        @default(now())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id])
  userId       String? // no @relation — User is hard-deletable via DELETE /team/:id
  actorEmail   String // copied at the time — same reason as TransactionEvent
  actorName    String? // copied at the time; null for unauthenticated intents (e.g. login against an unknown email)
  actorRole    String? // copied at the time
  actorStoreId String? // copied at the time — no @relation, Store is deletable too
  eventType    IntentEventType
  severity     IntentSeverity
  detail       Json?
  ipAddress    String?
  userAgent    String?

  @@index([businessId, userId, eventType, createdAt])
}

// Subscription/Plan/AdminUser/AuditLog tables are owned and created by the
// YapLin_Admin back-office (raw SQL, see YapLin_Admin/db/*.sql). They are
// declared here only so this backend can read/update them with typed
// Prisma queries. Never run `prisma migrate`/`db push` for these models —
// only `prisma generate`, the tables already exist in the shared database.

model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()::text"))
  name         String   @unique
  price        Decimal  @db.Decimal(10, 2)
  billingCycle String   @default("monthly")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  subscriptions Subscription[]
}

model Subscription {
  id               String             @id @default(dbgenerated("gen_random_uuid()::text"))
  businessId       String             @unique
  business         Business           @relation(fields: [businessId], references: [id])
  plan             String             @default("basic")
  planId           String?
  planRef          Plan?              @relation(fields: [planId], references: [id])
  status           SubscriptionStatus @default(trial)
  startDate        DateTime           @default(now())
  currentPeriodEnd DateTime
  amount           Decimal?           @db.Decimal(10, 2)
  billingCycle     String?
  autoRenew        Boolean            @default(true)
  suspendedAt      DateTime?
  suspendedReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @default(now())
}

enum AuditAction {
  CREATE
  UPDATE
  SUSPEND
  REACTIVATE
  PASSWORD_RESET
  DELETE
  RENEW
  EXPIRE
}

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt  DateTime    @default(now())
  adminId    String?
  adminEmail String
  action     AuditAction
  entityType String
  entityId   String
  businessId String?
  summary    String
  changes    Json?
  ipAddress  String?
  userAgent  String?
  origin     String?
}
